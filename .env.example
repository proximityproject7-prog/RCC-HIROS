# RCC-HIROS Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it's in .gitignore.

# MySQL database connection (XAMPP MariaDB)
DATABASE_URL="mysql://root:@localhost:3306/rcc_hiros"

# Strong random secret for JWT signing (required)
# Generate with: openssl rand -base64 64
JWT_SECRET="change-me-to-a-random-secret"

# Python fingerprint service WebSocket URL
NEXT_PUBLIC_FINGERPRINT_SERVICE_URL="ws://localhost:8765"
